# Secrets shared by all destinations (dev + production).
# All values are pulled from ENV or local files — DO NOT ENTER RAW CREDENTIALS HERE.

# GHCR token: GITHUB_TOKEN in CI, or a PAT with write:packages locally (e.g. from .env)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# From ENV in CI (GitHub secret); falls back to the local file for manual deploys.
# tr -cd '0-9a-f' strips any stray characters a copy-paste may have added to the
# secret, so the master key is always exactly its 32 hex chars (16 bytes).
RAILS_MASTER_KEY=$(printf '%s' "${RAILS_MASTER_KEY:-$(cat config/master.key)}" | tr -cd '0-9a-f')

# LINE channel secret; trim any stray whitespace from a paste.
LINE_CHANNEL_SECRET=$(printf '%s' "$LINE_CHANNEL_SECRET" | tr -d '[:space:]')
