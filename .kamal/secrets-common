# Secrets shared by all destinations (dev + production).
# All values are pulled from ENV or local files — DO NOT ENTER RAW CREDENTIALS HERE.

# GHCR token: GITHUB_TOKEN in CI, or a PAT with write:packages locally (e.g. from .env)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# From ENV in CI (GitHub secret); falls back to the local file for manual deploys
RAILS_MASTER_KEY=${RAILS_MASTER_KEY:-$(cat config/master.key)}

# LINE channel secret, pulled from the deployer's environment (e.g. .env or shell)
LINE_CHANNEL_SECRET=$LINE_CHANNEL_SECRET
