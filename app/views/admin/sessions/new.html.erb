<div class="min-h-screen flex items-center justify-center bg-gray-50">
  <div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow">
    <h1 class="mb-4 text-2xl font-semibold text-[#2E2E2D]">Admin Login</h1>

    <% if flash[:alert] %>
      <p class="mb-4 rounded-xl bg-red-50 px-4 py-2 text-sm text-red-600"><%= flash[:alert] %></p>
    <% end %>

    <%= form_with url: admin_login_path, method: :post, data: { turbo: false } do |f| %>
      <div class="mb-4">
        <%= f.label :email, "Email", class: "mb-1 block text-sm text-[#989A96]" %>
        <%= f.email_field :email, required: true, autofocus: true,
              class: "w-full rounded-xl border border-[#E0E1E0] px-3 py-2 focus:border-[#95C24A] focus:outline-none" %>
      </div>

      <div class="mb-6">
        <%= f.label :password, "Password", class: "mb-1 block text-sm text-[#989A96]" %>
        <%= f.password_field :password, required: true,
              class: "w-full rounded-xl border border-[#E0E1E0] px-3 py-2 focus:border-[#95C24A] focus:outline-none" %>
      </div>

      <%= f.submit "Login",
            class: "w-full cursor-pointer rounded-xl bg-[#95C24A] py-3 font-medium text-white hover:opacity-90" %>
    <% end %>
  </div>
</div>
