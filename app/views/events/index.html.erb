<% if @user %>
  <div class="flex justify-between items-center gap-2 px-4 fixed h-12 top-0 right-0 left-0 bg-white z-1 border-b-1 border-[#E0E1E0]"">
      <div class="flex items-center gap-3">
        <img class="h-6 w-6 rounded-2xl" src="<%= @user.picture_url %>" />
        <p class="text-[#2E2E2D]"><%= @user.display_name %></p>
      </div>
      <div></div>
  </div>
<% end %>

<div class="mb-4 flex items-center justify-between mt-12">
  <h1 class="text-3xl font-semibold text-gray-900">Events</h1>

  <%= link_to "สร้าง Event", events_new_path,
    class: "rounded-xl bg-[#95C24A] px-4 py-2 text-white shadow-sm hover:opacity-90" %>

</div>
<div class="mb-4 flex items-center gap-3 text-sm">
  <div class="flex items-center gap-2">
    <span class="inline-flex h-[25px] w-[67px] items-center justify-center rounded-[8px] bg-[#95C24A] px-3 py-1 text-white">
      Race
    </span>
  </div>
  <div class="flex items-center gap-2">
    <span class="inline-flex h-[25px] w-[67px] items-center justify-center rounded-[8px] bg-[#EC8735] px-3 py-1 text-white">
      Camp
    </span>
  </div>
</div>
<% if @events_by_category.any? %>
  <% @events_by_category.each do |category, events| %>
    <div class="mb-6">
      <h2 class="text-2xl font-semibold text-gray-700 mb-3">
            <%= (category.presence || "uncategorized").capitalize %>
      </h2>
      <% events.each do |event| %>
  <%= link_to event_path(event), class: "block" do %>
    <div class="mb-3 rounded-xl bg-white p-4 shadow-sm hover:shadow-md transition">
      <h3 class="text-xl font-semibold text-gray-800">
        <%= event.name %>
      </h3>
    </div>
  <% end %>
<% end %>
    </div>
  <% end %>
<% else %>
  <p>ยังไม่มี event</p>
<% end %>
