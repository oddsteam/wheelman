<div data-controller="events-view"
     data-events-view-active-categories-value='<%= %w[race camp].to_json %>'
     data-events-view-initial-view-value="<%= params[:view] == "calendar" ? "calendar" : "list" %>">

  <%# Top bar %>
  <div class="flex justify-between items-center gap-2 px-4 fixed h-12 top-0 right-0 left-0 bg-white z-10 border-b border-[#E0E1E0]">
    <div class="flex items-center gap-3">
      <% if current_user %>
        <% if current_user.picture_url.present? %>
          <img class="h-6 w-6 rounded-full" src="<%= current_user.picture_url %>" />
        <% end %>
        <p class="text-[#2E2E2D]"><%= current_user.display_name || current_user.email %></p>
      <% end %>
    </div>

    <div class="flex items-center gap-2">
      <%# List / Calendar toggle %>
      <button type="button"
              data-action="events-view#toggleView"
              aria-label="Switch view"
              class="flex h-9 w-9 items-center justify-center rounded-xl border border-[#95C24A] text-[#95C24A] hover:bg-green-50">
        <%# calendar icon — shown while in list view %>
        <svg data-events-view-target="calendarIcon" xmlns="http://www.w3.org/2000/svg" fill="none"
             viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
        </svg>
        <%# list icon — shown while in calendar view %>
        <svg data-events-view-target="listIcon" xmlns="http://www.w3.org/2000/svg" fill="none"
             viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="hidden h-5 w-5">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>

      <%# Create event — only roles that can create %>
      <% if current_user&.can_create_events? %>
        <%= link_to events_new_path, aria: { label: "Create event" },
              class: "flex h-9 w-9 items-center justify-center rounded-xl border border-[#95C24A] text-[#95C24A] hover:bg-green-50" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
        <% end %>
      <% end %>

      <%# Logout %>
      <%= button_to logout_path, method: :delete, aria: { label: "Logout" },
            class: "flex h-9 w-9 cursor-pointer items-center justify-center rounded-xl border border-[#E0E1E0] text-[#989A96] hover:bg-gray-50",
            form: { data: { turbo_confirm: "Logout?" }, onsubmit: "if (window.location.hostname !== 'localhost' && window.liff?.isLoggedIn?.()) liff.logout();" } do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
        </svg>
      <% end %>
    </div>
  </div>

  <%# ============================ LIST VIEW ============================ %>
  <div data-events-view-target="list" class="mt-12">
    <div class="mb-4 flex items-center justify-between">
      <h1 class="text-3xl font-semibold text-gray-900">Events</h1>
    </div>

    <div class="mb-4 flex items-center gap-3 text-sm">
      <div class="flex items-center gap-2">
        <span class="inline-flex h-[25px] w-[67px] items-center justify-center rounded-[8px] bg-[#95C24A] px-3 py-1 text-white">
          Race
        </span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex h-[25px] w-[67px] items-center justify-center rounded-[8px] bg-[#EC8735] px-3 py-1 text-white">
          Camp
        </span>
      </div>
    </div>

    <% if @events_by_category.any? %>
      <% @events_by_category.each do |category, events| %>
        <div class="mb-6">
          <h2 class="text-2xl font-semibold text-gray-700 mb-3">
            <%= (category.presence || "uncategorized").capitalize %>
          </h2>
          <% events.each do |event| %>
            <% if current_user&.can_view_event_details? %>
              <%= link_to event_path(event), class: "block" do %>
                <div class="mb-3 rounded-xl bg-white p-4 shadow-sm hover:shadow-md transition">
                  <h3 class="text-xl font-semibold text-gray-800"><%= event.name %></h3>
                </div>
              <% end %>
            <% else %>
              <div class="mb-3 rounded-xl bg-white p-4 shadow-sm">
                <h3 class="text-xl font-semibold text-gray-800"><%= event.name %></h3>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p>ยังไม่มี event</p>
    <% end %>
  </div>

  <%# ========================== CALENDAR VIEW ========================== %>
  <div data-events-view-target="calendar" class="hidden mt-12">
    <%# Category filter pills %>
    <div class="mb-4 flex items-center gap-3">
      <% %w[race camp].each do |category| %>
        <button type="button"
                data-action="events-view#toggleCategory"
                data-category="<%= category %>"
                data-color="<%= category_color(category) %>"
                data-tint="<%= category_tint(category) %>"
                data-events-view-target="pill"
                class="h-[34px] min-w-[88px] rounded-xl px-4 text-sm font-medium transition"
                style="background-color: <%= category_color(category) %>; color: #ffffff;">
          <%= category_meta(category)[:label] %>
        </button>
      <% end %>
    </div>

    <turbo-frame id="calendar_grid">
      <%# Year navigation %>
      <div class="mb-4 flex items-center justify-between gap-2">
        <%= link_to events_path(view: "calendar", year: @year - 1),
              data: { turbo_frame: "calendar_grid" },
              class: "flex h-11 w-12 items-center justify-center rounded-xl border border-[#E0E1E0] text-gray-700 hover:bg-gray-50" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
          </svg>
        <% end %>

        <h2 class="text-xl font-semibold text-[#2E2E2D]"><%= @year %></h2>

        <%= link_to events_path(view: "calendar", year: @year + 1),
              data: { turbo_frame: "calendar_grid" },
              class: "flex h-11 w-12 items-center justify-center rounded-xl border border-[#E0E1E0] text-gray-700 hover:bg-gray-50" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        <% end %>
      </div>

      <%# 12 month cards %>
      <div class="grid grid-cols-3 gap-2">
        <% (1..12).each do |month| %>
          <div class="min-h-[120px] rounded-xl border border-[#E0E1E0] bg-white p-2 shadow-sm">
            <h3 class="mb-2 text-center text-base font-semibold text-[#95C24A]">
              <%= Date::ABBR_MONTHNAMES[month].upcase %>
            </h3>
            <% Array(@events_by_month[month]).each do |event| %>
              <%= render "events/event_chip", event: event %>
            <% end %>
          </div>
        <% end %>
      </div>
    </turbo-frame>
  </div>
</div>
