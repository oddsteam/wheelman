<div class="min-h-screen bg-gray-50 py-2">
  <div class="max-w-xl mx-auto">

    <!-- Back -->
    <div class="py-[20px] md:p-6 space-y-2">
    <%= link_to :back, class: "inline-block px-4 py-2 border border-[#95C24A] rounded-xl text-sm text-gray-700 hover:bg-green-50" do %>
   ← Back
    <% end %>
    </div>

    <!-- Card -->
    <div class="bg-white rounded-2xl shadow p-[8px]">

      <!-- Photo -->
      <div class="flex justify-center items-center">
      <%= image_tag(
        @event.photo.attached? ? url_for(@event.photo) : "Default-Event.png",
        class: "max-w-full h-auto object-fill rounded-lg mb-2"
      ) %>
      </div>

      <!-- Title -->
      <h1 class="text-[20px] font-normal text-[#2E2E2D] px-[4px] mb-2">
        <%= @event.name %>
      </h1>

      <!-- Activity -->
      <%
      activity_map = {
        "swimming" => { label: "Swimming", icon: "Swim.png" },
        "running"  => { label: "Running",  icon: "Run.png" },
        "cycling"  => { label: "Cycling",  icon: "Bike.png" }
      }
      %>

      <% if @event.activity_type.present? %>
        <div class="flex flex-wrap gap-3 mb-2 px-[4px]">
          <% @event.activity_type.each do |type| %>
            <% item = activity_map[type] %>
            <% next unless item %>

            <div class="pr-4 py-2 bg-white rounded-xl flex items-center gap-2">
              <%= image_tag item[:icon], width: 20, height: 20 %>
              <span class="text-[12px] font-light text-[#2E2E2D]">
                <%= item[:label] %>
              </span>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Description -->
      <p class="text-[#989A96] text-[14px] font-light px-[4px]">Description</p>
      <p class="text-[#2E2E2D] text-[14px] font-normal mb-2 px-[4px] break-words">
        <%= @event.description %>
      </p>

      <!-- Location -->
      <p class="text-[#989A96] text-[14px] font-light px-[4px]">Location</p>
      <p class="text-[#2E2E2D] text-[14px] font-normal px-[4px] ">
        <%= @event.location_description %>
      </p>
      <div class="px-[4px] mb-2">
      <% if @event.location_link.present?%>
        <%= link_to @event.location_link,
        @event.location_link,
        target: "_blank",
        class: "underline" %>
      <% end %>
      </div>

      <!-- Date -->
      <p class="text-[#989A96] text-[14px] font-light px-[4px]">Date</p>
      <p class="text-[#2E2E2D] text-[14px] font-normal mb-4 px-[4px]">
        <%= format_date_range(@event.start_date, @event.end_date) %>
      </p>

      <!-- Participants -->
      <p class="text-[#989A96] text-[14px] font-light px-[4px]">Participants</p>
      <p class="text-[#2E2E2D] text-[14px] font-normal mb-4 px-[4px]">
        <%= @event.participants.size %> joined
      </p>

      <!-- Join / Leave -->
      <% if current_user&.can_join_events? %>
        <div>
          <% if current_user.joined?(@event) %>
            <%= button_to leave_event_path(@event), method: :delete,
                  class: "w-full py-3 rounded-xl border border-[#95C24A] text-[#95C24A] font-medium cursor-pointer hover:bg-green-50" do %>
              ✓ Joined · Leave
            <% end %>
          <% else %>
            <%= button_to join_event_path(@event),
                  class: "w-full py-3 rounded-xl bg-[#95C24A] hover:bg-[#7ea63d] text-white font-medium cursor-pointer" do %>
              Confirm &amp; Join!
            <% end %>
          <% end %>
        </div>
      <% end %>

      <!-- Delete (creator or admin) -->
      <% if current_user&.admin? || @event.user_id == current_user&.id %>
        <div class="mt-3">
          <%= button_to event_path(@event), method: :delete,
                form: { data: { turbo_confirm: "Delete this event?" } },
                class: "w-full py-2 rounded-xl border border-red-300 text-red-500 text-sm font-medium cursor-pointer hover:bg-red-50" do %>
            Delete event
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>